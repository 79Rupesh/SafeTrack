<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safety_red_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/safety_red_dark"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/surface_light"
            app:title="Emergency Distress Assistance"
            app:titleTextColor="@color/surface_light" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Distress Header -->
            <TextView
                android:id="@+id/tvSosStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="EMERGENCY DISTRESS SYSTEM"
                android:textColor="@color/safety_red_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSosStatusDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Press and hold the red button below for 2 seconds to dispatch immediate emergency distress signals to your trusted contacts."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Circular Big Hold-to-SOS Button Container -->
            <FrameLayout
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="28dp">

                <View
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:background="@drawable/bg_sos_ring_outer" />

                <ProgressBar
                    android:id="@+id/progressHold"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_sos_button"
                    android:visibility="invisible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSosHold"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sos_button"
                    android:elevation="8dp"
                    android:text="HOLD FOR\nSOS"
                    android:textColor="@color/surface_light"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.02"
                android:text="Hold button for 2 seconds"
                android:textColor="@color/safety_red_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Emergency Safety Tools (Siren Alarm & Flashlight Strobe) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleSiren"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Loud Siren"
                    android:textColor="@color/safety_red_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_siren"
                    app:iconTint="@color/safety_red_dark"
                    app:strokeColor="@color/safety_red" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleTorch"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Flashlight"
                    android:textColor="@color/safety_red_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_flashlight"
                    app:iconTint="@color/safety_red_dark"
                    app:strokeColor="@color/safety_red" />
            </LinearLayout>

            <!-- 112 Call Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirect112Call"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/safety_red_dark"
                android:letterSpacing="0.02"
                android:text="@string/call_police_112"
                android:textColor="@color/surface_light"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart" />

            <!-- Offline Emergency SMS Fallback Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendOfflineSms"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Send Emergency SMS (Offline Fallback)"
                android:textColor="@color/safety_red_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/safety_red" />

            <!-- Cancel SOS Button (shown when SOS active) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSos"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/safety_green"
                android:letterSpacing="0.02"
                android:text="I AM SAFE NOW (Cancel SOS Alert)"
                android:textColor="@color/surface_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
